APP_NAME=Yuzme AI Asistani
ENVIRONMENT=development
LOG_LEVEL=INFO

# Provider values are explicit; unconfigured providers must not fabricate results.
LLM_PROVIDER=mock
LLM_API_KEY=
STT_PROVIDER=mock
TTS_PROVIDER=mock
RESEARCH_PROVIDER=unconfigured
RESEARCH_API_KEY=
OBJECT_STORAGE_PROVIDER=unconfigured
EMAIL_PROVIDER=unconfigured
PUSH_PROVIDER=unconfigured

# Persistence
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yuzme_ai_db
REPOSITORY_BACKEND=postgres
AUTH_SECRET=replace-with-a-long-random-secret
REDIS_URL=redis://localhost:6379/0
CHECKPOINT_PROVIDER=redis

# Google OAuth / OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback
FRONTEND_URL=https://app.example.com
# Comma-separated production and Vercel preview origins accepted by CORS.
FRONTEND_URLS=https://app.example.com,https://your-project.vercel.app
